# Copy to .env and fill in.  cp .env.example .env
# Generate secrets with:  openssl rand -hex 32

# --- LiteLLM admin / signing -------------------------------------------------
# Must start with "sk-". This is the proxy admin key.
LITELLM_MASTER_KEY=sk-CHANGE_ME_master
# Used to encrypt stored provider keys in the DB. Set once, never rotate casually.
LITELLM_SALT_KEY=CHANGE_ME_salt

# --- Postgres ----------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME_db_password

# --- Open WebUI --------------------------------------------------------------
WEBUI_SECRET_KEY=CHANGE_ME_webui_secret

# --- Provider API keys -------------------------------------------------------
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
DEEPSEEK_API_KEY=sk-...

# --- Observability: Langfuse infra (generate hex secrets: openssl rand -hex 32)
LANGFUSE_POSTGRES_PASSWORD=CHANGE_ME_lf_postgres
LANGFUSE_CLICKHOUSE_PASSWORD=CHANGE_ME_lf_clickhouse
LANGFUSE_MINIO_PASSWORD=CHANGE_ME_lf_minio_min8
LANGFUSE_REDIS_PASSWORD=CHANGE_ME_lf_redis
LANGFUSE_SALT=CHANGE_ME_hex32
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME_hex32
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME_hex32

# --- Observability: LiteLLM -> Langfuse (fill AFTER creating a Langfuse project
#     at http://localhost:3002 -> Settings -> API Keys). HOST is the in-network URL.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://langfuse-web:3000

# --- Observability: Grafana --------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana
